# --- GLM Coding Plan ---
# Required for GLM data. The raw key (sent as Authorization header, no "Bearer " prefix).
GLM_API_KEY=
# Optional: switch to international endpoint (api.z.ai) if you use z.ai instead of bigmodel.cn
# GLM_BASE_URL=https://api.z.ai
# Extra accounts: GLM_API_KEY_2= …

# --- Codex (ChatGPT) ---
# Path to Codex/ChatGPT auth file. Defaults to ~/.codex/auth.json
# CODEX_AUTH_PATH=/Users/you/.codex/auth.json
# Override the usage endpoint (internal, may change)
# CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage

# --- Claude Code ---
# Reads OAuth token from ~/.claude/.credentials.json (created when you log in
# via `claude` with a subscription). No key needed — just be logged in.
# Override the credentials path or usage API if your setup differs:
# CLAUDE_CREDENTIALS_PATH=/Users/you/.claude/.credentials.json
# CLAUDE_USAGE_API=https://api.anthropic.com/api/oauth/usage
# Fetch timeout (ms)
# CLAUDE_TIMEOUT_MS=15000

# --- Gemini (Google One / Antigravity CLI) ---
# Reads OAuth token from ~/.gemini/antigravity-cli/antigravity-oauth-token
# (written when you log in via `agy` with a Google One subscription).
# Expired tokens are refreshed automatically. No key needed — just be logged in.
# Override the credentials path or usage API if your setup differs:
# GEMINI_CREDENTIALS_PATH=/Users/you/.gemini/antigravity-cli/antigravity-oauth-token
# GEMINI_QUOTA_API=https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary
# GEMINI_TIMEOUT_MS=15000

# --- Server ---
# Port is fixed at 5928 in package.json scripts (next start/dev -p 5928).
# Next.js binds the port before loading .env, so PORT here would be ignored.

# --- SuperGrok (xAI Grok / grok.com) ---
# Path to the Grok CLI credentials (created by running `grok login`).
# The dashboard reads the OAuth token and calls the same billing endpoint
# the CLI uses (weekly usage pool for SuperGrok / unified billing).
# GROK_AUTH_PATH=/Users/you/.grok/auth.json
# In Docker, mount the ~/.grok directory read-write and point GROK_AUTH_PATH at
# /secrets/grok/auth.json. A :ro file mount will refuse refresh (and used to
# burn the grok CLI login).
# Override endpoints only if you are using a proxy / custom build:
# GROK_BILLING_URL=https://cli-chat-proxy.grok.com/v1/billing?format=credits
# GROK_SETTINGS_URL=https://cli-chat-proxy.grok.com/v1/settings

# --- MiniMax (国内端点默认 minimaxi.com) ---
# 使用 Token Plan 的 Subscription Key（不是普通的 pay-as-you-go Key）
# 国内默认使用 https://www.minimaxi.com/v1/token_plan/remains
# 如果是国际版可设置 MINIMAX_BASE_URL=https://www.minimax.io
MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://www.minimaxi.com
# Extra accounts: MINIMAX_API_KEY_2= …

# --- Kimi (Kimi Code 会员) ---
# Reads OAuth credentials from ~/.kimi-code/credentials/kimi-code.json (written
# by the Kimi Code CLI login). Expired tokens are refreshed automatically and
# written back. Nothing to set if you use the CLI on this machine.
# KIMI_CREDENTIALS_PATH=/Users/you/.kimi-code/credentials/kimi-code.json
# Or skip OAuth entirely with an API Key from the Kimi Code Console:
# KIMI_API_KEY=
# Override endpoints only if you are using a proxy / custom build:
# KIMI_USAGE_URL=https://api.kimi.com/coding/v1/usages
# KIMI_TOKEN_URL=https://auth.kimi.com/api/oauth/token
#
# Extra accounts (any key-based provider): append _2, _3, … to the vars below.
# They merge into the same card — bars combine all accounts, and the card gets
# a Σ/1/2 toggle for per-account detail. Gaps in numbering are fine.
# Recommended: API Keys from each account's Kimi Code Console.
# KIMI_API_KEY_2=
# KIMI_CREDENTIALS_PATH_2=/Users/you/.kimi-code/credentials/kimi-code-2.json

# --- Volcengine (火山方舟 Coding Plan) ---
# AK/SK pair from 火山引擎控制台 → 密钥管理 (https://console.volcengine.com/iam/keymanage/)
# Signs GetCodingPlanUsage (current product) / GetAFPUsage (older Agent Plan fallback),
# both HMAC-SHA256 V4. Returns session(5h)/weekly/monthly usage windows.
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
# Extra accounts: VOLC_ACCESS_KEY_2= / VOLC_SECRET_KEY_2= …

# --- StepFun (阶跃星辰 Step Plan) ---
# Step Plan quota lives on platform.stepfun.com behind your web session — the
# sk- API key only exposes the top-up balance, so this provider needs the
# session instead. Get it from a logged-in browser:
#   1. open https://platform.stepfun.com/plan-usage (stay logged in)
#   2. DevTools → Network → any /api/... Dashboard request
#   3. copy the request's `cookie` header value (or just Oasis-Token's value)
# Paste the whole cookie (simplest; keeps Oasis-Webid + INGRESSCOOKIE aligned):
# STEPFUN_COOKIE=Oasis-Token=…; Oasis-Webid=…; INGRESSCOOKIE=…
# Or paste only the token — the required Oasis-Webid header is then decoded
# from the token's own device_id claim. Paste the paired "access...refresh"
# form if you have it: an expired access token is then refreshed for you
# (in memory only; nothing is written to disk).
# STEPFUN_TOKEN=…
# Force the webid when the auto-derived one is rejected:
# STEPFUN_WEBID=…
# International accounts:
# STEPFUN_BASE_URL=https://platform.stepfun.ai
# A renewed token pair is cached here (0600) — StepFun rotates the refresh token,
# and the spent half left in this file is worthless, so the cache must survive a
# restart. Defaults to ./.stepfun-session.json; Docker points it at a writable
# mount (see docker-compose.yml). Set it to an unwritable path for memory-only.
# STEPFUN_SESSION_FILE=/var/lib/quota-peek/stepfun-session.json
# Extra accounts: STEPFUN_COOKIE_2= / STEPFUN_TOKEN_2= …

# --- DeepSeek ---
# 余额：官方接口，sk- API Key（platform.deepseek.com → API Keys 页）。
# 本月已用：内部接口，需网页控制台会话令牌（不是 sk- key）——
#   登录 https://platform.deepseek.com/usage → F12 控制台执行
#   JSON.parse(localStorage.getItem('userToken')).value
#   复制输出填到 DEEPSEEK_TOKEN。令牌失效时卡片自动降级为只显余额。
DEEPSEEK_API_KEY=
# DEEPSEEK_TOKEN=
# Extra accounts: DEEPSEEK_API_KEY_2= / DEEPSEEK_TOKEN_2= …

# --- 小米 MiMo（platform.xiaomimimo.com）---
# 用量/余额只认网页会话（tp- API Key 只能消费额度，查不了）。两种方式：
#
# 方式 A（推荐，免每日重贴）：小米账号 SSO 种子，cookie 过期时自动换新。
#   1. 浏览器登录 https://account.xiaomi.com（平时能免登录打开 MiMo 的那个浏览器）
#   2. F12 → Application → Cookies → https://account.xiaomi.com
#   3. 只复制 userId 和 passToken 两个 cookie 的值（passToken 是 HttpOnly，
#      在 DevTools 里能看到；Network 面板任一 account.xiaomi.com 请求的
#      请求 Cookie 里也有）
#   ⚠️ passToken 是长效账号级凭据，等同密码，只放 .env，不要贴给任何
#      人/工具/聊天窗口；泄露则到 account.xiaomi.com 退出登录使其失效。
MIMO_USER_ID=
MIMO_PASS_TOKEN=
#
# 方式 B（手动，~24h 过期后重贴）：控制台 Cookie 头。
#   登录 platform.xiaomimimo.com → F12 → Network → 任一 api/v1/… 请求 →
#   复制完整 Cookie 请求头（关键是 api-platform_serviceToken）。
MIMO_COOKIE=
#
# 自动换新后的 cookie/轮换种子缓存（0600；重启后免重新交换，同 StepFun
# 的 session 模式）。默认 ./.mimo-session.json；Docker 指向可写挂载。
# MIMO_SESSION_FILE=/var/lib/quota-peek/mimo-session.json
# Extra accounts: MIMO_USER_ID_2= / MIMO_PASS_TOKEN_2= / MIMO_COOKIE_2= …

# --- OpenRouter（openrouter.ai）---
# 管理 key（settings/management-keys 建）一把拿全：钱包余额
#   （/api/v1/credits）和全账号当月消费（analytics，含没配进来的 key）。
#   不能调模型、能增删账号下所有 key，务必设过期时间，只放 .env。
# 普通 key（settings/keys 建，可选）：只在没配管理 key 时作回退——查它
#   自己那把 key 的当月消费（多把就 _2/_3 合并），看不到钱包余额。
OPENROUTER_MANAGEMENT_KEY=
# OPENROUTER_API_KEY=
# Extra accounts: OPENROUTER_API_KEY_2= …

# --- Usage history（后台采样 + 记录）---
# 服务端每 QP_POLL_INTERVAL_MS 毫秒把所有已配置渠道各取一次数，把百分比、
# 绝对用量（余额/消费/credit）、每个子账号、以及失败原因写进 SQLite；
# 卡片上的 sparkline / Δ 和 /history 页都读这个库。
# QP_POLL=0 关掉后台采样（只在有人打开页面时记录）。默认开。
# QP_POLL=1
# 采样间隔，默认 5 分钟；下限 60 秒（写太密会打爆限流 API）。
# QP_POLL_INTERVAL_MS=300000
# SQLite 落盘目录，默认 ./data（Docker 里是 /app/data，已挂卷）。
# QP_DATA_DIR=./data
# 原始样本保留天数，默认 90；更早的样本在每轮采样后自动删除。
# QP_HISTORY_DAYS=90
# 取数结果在进程内的复用窗口（秒），避免轮询和页面刷新同时打同一个渠道。
# QP_CACHE_TTL_MS=60000
# 启动时轮询器通过回环请求 /api/poll 自我唤起；端口被映射时改成实际端口。
# QP_SELF_URL=http://127.0.0.1:5928
